# ============================================================
# Readest Application - Environment Configuration Template
# Copy this file to .readest.env and customize for your deployment
# ============================================================

# =====================
# Application Platform
# =====================
NEXT_PUBLIC_APP_PLATFORM=web

# =====================
# Storage Configuration
# =====================
# Storage mode: 'local' for file-based storage (Docker deployments)
STORAGE_MODE=local
NEXT_PUBLIC_STORAGE_MODE=local

# Local storage root path (inside container)
LOCAL_STORAGE_ROOT=/app/books

# =====================
# API Base URLs
# =====================
# 前端会自动检测访问源（localhost、内网IP、外网域名）并选择对应的 API 地址
# 
# 配置优先级：
# 1. NEXT_PUBLIC_API_BASE_URL - 固定 API 地址（不建议在内外网混合环境中使用）
# 2. NEXT_PUBLIC_EXTERNAL_API_BASE_URL - 外网访问时的 API 地址（当检测到外网访问时使用）
# 3. 自动检测 - 使用当前访问的协议和域名
#
# 使用场景示例：
# 
# 场景 1: 纯内网部署（推荐）
#   只配置 NEXT_PUBLIC_API_BASE_URL，设置为内网 IP:
#   NEXT_PUBLIC_API_BASE_URL=http://192.168.1.100:3000
#
# 场景 2: 内外网混合（推荐）
#   不配置 NEXT_PUBLIC_API_BASE_URL（留空），前端自动检测
#   或配置 NEXT_PUBLIC_EXTERNAL_API_BASE_URL 用于外网访问：
#   NEXT_PUBLIC_EXTERNAL_API_BASE_URL=https://readest.example.com
#
# 场景 3: 固定外网地址
#   NEXT_PUBLIC_API_BASE_URL=https://readest.example.com

# API base URL (used for general API requests)
# 留空时前端自动检测；localhost/内网IP使用当前地址，外网使用 NEXT_PUBLIC_EXTERNAL_API_BASE_URL
NEXT_PUBLIC_API_BASE_URL=

# 外网访问时的 API 地址（仅在内外网混合环境中需要配置）
NEXT_PUBLIC_EXTERNAL_API_BASE_URL=

# 以下参数保持与 NEXT_PUBLIC_API_BASE_URL 一致（通常不需要单独配置）
NEXT_PUBLIC_WEB_BASE_URL=
NEXT_PUBLIC_NODE_BASE_URL=
NEXT_PUBLIC_STORAGE_BASE_URL=

# =====================
# Authentication Configuration
# =====================
# AUTH_SECRET: Used for JWT token signing (auto-generated if not provided)
# Generate with: openssl rand -hex 32
AUTH_SECRET=52232b554d04d61ead7b0d3f091ec57a45cc5cc6e950e3d12dd87f5d55bbd96e

# AUTH_PASSWORD: Login password (auto-generated if not provided)
# Generate with: openssl rand -hex 16
AUTH_PASSWORD=cdfa93db5980201d02bcf3155bae8ba7

# =====================
# CORS Configuration
# =====================
# Additional allowed origins for CORS (comma-separated)
# Automatically allows local IPs (192.168.*.*, 10.*.*.*)
# Example: https://readest.celestehill.ltd:1412,https://example.com
ALLOWED_ORIGINS=

# =====================
# Supabase Configuration (Local Mode Dummy)
# =====================
# Keep these as dummy values for local deployments
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-mode-dummy-key

# =====================
# Optional: Node Environment
# =====================
# NODE_ENV=production
